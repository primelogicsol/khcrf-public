model OfflinePaymentSubmission {
  id                String                     @id @default(cuid())
  donationIntentId  String?
  paymentMethod     DonationPaymentMethod
  amount            Float
  currency          String                     @default("INR")
  utrNumber         String?                    @unique
  paymentDate       DateTime?
  originatingBank   String?
  accountHolderName String?
  paymentProofUrl   String?
  instrumentType    String?
  instrumentNumber  String?
  issuingBank       String?
  instrumentDate    DateTime?
  courierTracking   String?
  submissionStatus  String                     @default("SUBMITTED")
  paymentStatus     String                     @default("AWAITING_VERIFICATION")
  receiptStatus     String                     @default("NOT_ELIGIBLE")
  verifiedAt        DateTime?
  verifiedBy        String?
  adminNotes        String?
  rejectionReason   String?
  duplicateOfId     String?
  duplicateReason   String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  donationIntent    DonationIntent?            @relation(fields: [donationIntentId], references: [id])
  duplicateOf       OfflinePaymentSubmission?  @relation("DuplicateOfflineSubmission", fields: [duplicateOfId], references: [id])
  duplicates        OfflinePaymentSubmission[] @relation("DuplicateOfflineSubmission")

  @@unique([paymentMethod, instrumentNumber], map: "offline_payment_submissions_active_instrument_unique", where: raw("((\"instrumentNumber\" IS NOT NULL) AND (\"submissionStatus\" = 'SUBMITTED'::text) AND (\"paymentStatus\" = ANY (ARRAY['AWAITING_VERIFICATION'::text, 'RECEIVED'::text, 'DEPOSITED'::text, 'VERIFIED'::text, 'CLEARED'::text])))"))
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([donationIntentId])
  @@index([createdAt])
  @@index([verifiedBy])
  @@map("offline_payment_submissions")
}

