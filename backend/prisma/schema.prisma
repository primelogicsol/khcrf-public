generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                       @id @default(cuid())
  name                        String
  email                       String                       @unique
  password                    String
  avatarUrl                   String?
  isAdmin                     Boolean                      @default(false)
  isVerified                  Boolean                      @default(false)
  otp                         String?
  otpExpiresAt                DateTime?
  role                        Role                         @default(USER)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  currentSessionId            String?
  isMember                    Boolean                      @default(false)
  authProvider                String                       @default("local")
  googleId                    String?                      @unique
  isTrashed                   Boolean                      @default(false)
  status                      UserStatus                   @default(PENDING)
  accreditationApplications   AccreditationApplication[]
  apprenticeshipApplications  ApprenticeshipApplication[]
  blogPostReports             BlogPostReport[]
  createdEntities             CanonicalEntity[]            @relation("EntityCreator")
  cceApplications             CceApplication[]
  ccsiProfiles                CcsiProfile[]
  certifications              Certification[]
  chapterReviews              ChapterReview[]
  donations                   Donation[]
  editorialAuditLogs          EditorialAuditLog[]
  createdRelationships        EntityRelationship[]         @relation("RelationshipCreator")
  evaluationSubmissions       EvaluationSubmission[]
  grantApplications           GrantApplication[]
  legislativeOffices          LegislativeOffice[]
  listings                    Listing[]
  loginHistory                LoginHistory[]
  masterArtisanStories        MasterArtisanStory[]
  uploadedMedia               MediaAsset[]                 @relation("MediaUploader")
  memberProfile               Member?
  officeSubscriptions         OfficeSubscription[]
  partnerApplications         PartnerApplication[]
  contributorPublications     Publication[]                @relation("contributorPublications")
  reviewComments              ReviewComment[]
  skcDataClassifications      SkcDataClassificationAudit[] @relation("SkcDataClassifiedBy")
  skcInstitutionRegistration  SkcInstitutionRegistration?
  skcScheduleOverrides        SkcScheduleOverride[]        @relation("SkcScheduleApprovedBy")
  skcStakeholderRegistration  SkcStakeholderRegistration?
  skcStakeholderVerifications SkcStakeholderRegistration[] @relation("SkcStakeholderVerifiedBy")
  createdReferences           SourceReference[]            @relation("ReferenceCreator")
  userPurchases               UserPurchase[]
  VerificationFinding         VerificationFinding[]
  verifications               VerificationRecord[]         @relation("Verifier")
  workflowActions             WorkflowRecord[]             @relation("WorkflowActor")
  donor                       Donor?
  knowledgeIntakes            KnowledgeIntake[]
  publicationReviews          PublicationReview[]

  @@index([email])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  ipAddress String?
  device    String?
  loginAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Member {
  id                String                      @id @default(cuid())
  userId            String                      @unique
  fullName          String
  dob               DateTime?
  gender            Gender?
  nationality       String?
  phone             String
  streetAddress     String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  membershipType    MembershipType
  paymentMethod     PaymentMethod
  status            MemberStatus                @default(PENDING)
  razorpayOrderId   String?                     @unique
  razorpayPaymentId String?                     @unique
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  profileData       Json?
  applicationStatus MembershipApplicationStatus @default(NOT_SUBMITTED)
  approvedAt        DateTime?
  approvedBy        String?
  expiresAt         DateTime?
  membershipStatus  MembershipStatus            @default(INACTIVE)
  permissions       String[]
  rejectedAt        DateTime?
  rejectionReason   String?
  suspendedAt       DateTime?
  user              User                        @relation(fields: [userId], references: [id])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  subject   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artisanId String?
}

model Listing {
  id                  String             @id @default(cuid())
  userId              String?
  type                RegisterType
  fullName            String
  email               String
  phone               String
  address             String
  status              MemberStatus       @default(PENDING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  adminCertificateUrl String?
  artisanProfile      ArtisanProfile?
  businessProfile     BusinessProfile?
  instituteProfile    InstituteProfile?
  user                User?              @relation(fields: [userId], references: [id])
  compliance          ListingCompliance?

  @@index([email])
}

model ArtisanProfile {
  id              String  @id @default(cuid())
  listingId       String  @unique
  specialty       String?
  skillLevel      String?
  experienceYears Int?
  awards          String?
  catalogUrl      String?
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id            String  @id @default(cuid())
  listingId     String  @unique
  name          String?
  email         String?
  address       String?
  foundedYear   Int?
  type          String?
  websiteUrl    String?
  productsSold  String?
  employeeCount Int?
  licenseNumber String?
  listing       Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model InstituteProfile {
  id               String  @id @default(cuid())
  listingId        String  @unique
  name             String?
  email            String?
  address          String?
  representative   String?
  repDesignation   String?
  type             String?
  websiteUrl       String?
  missionStatement String?
  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ListingCompliance {
  id                String   @id @default(cuid())
  listingId         String   @unique
  materialSource    String?
  craftingProcess   String?
  isSustainable     Boolean?
  sustainableDesc   String?
  paysFairWage      Boolean?
  supportsGender    Boolean?
  femaleEmployeePct Int?
  hasWorkplaceStd   Boolean?
  workplaceStdDesc  String?
  childLaborPolicy  Boolean?
  fairTradeCert     Boolean?
  fairTradeDoc      String?
  giCert            Boolean?
  giCertNumber      String?
  giCertDoc         String?
  blockchainCert    Boolean?
  blockchainCertDoc String?
  qualityConsent    Boolean?
  profileConsent    Boolean?
  complianceAck     Boolean?
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ApprenticeshipApplication {
  id                 String   @id @default(cuid())
  userId             String?
  fullName           String
  dob                String
  gender             String
  contactNumber      String
  email              String
  city               String
  state              String
  country            String
  postalCode         String
  qualification      String
  otherQualification String?
  fieldOfStudy       String
  institution        String
  completionYear     String
  apprenticeTrack    Json
  preferredLocation  Json
  availability       Json
  skills             Json
  otherSkill         String?
  experience         String?
  motivation         String
  heritageMeaning    String?
  contribution       String
  cvUrl              String?
  portfolioLink      String?
  portfolioFileUrl   String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User?    @relation(fields: [userId], references: [id])
}

model ApprenticeshipOpening {
  id           String   @id @default(cuid())
  title        String
  description  String
  location     String
  type         String   @default("FULL_TIME")
  duration     String
  stipend      String?
  requirements Json
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LegislativeOffice {
  id                     String               @id @default(cuid())
  userId                 String?
  representativeName     String
  designation            String
  constituency           String
  party                  String?
  termStart              String
  termEnd                String
  officeAddress          String
  officialEmail          String
  contactNumber          String
  officeRepName          String?
  officeRepDesignation   String?
  officeRepMobile        String?
  username               String               @unique
  primaryGroups          Json?
  craftSectors           Json
  intendedUse            Json?
  campaignDisclaimer     Boolean              @default(true)
  authDocUrl             String?
  sealDocUrl             String?
  digitalSignature       String?
  status                 String               @default("PENDING")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  artisanPopulation      String?
  artisanPresence        String?
  craftClusters          String?
  craftIssues            Json?
  district               String?
  engagementSummary      String?
  legislativeBody        String?
  officialWebsite        String?
  orgTypes               Json?
  priorityAreas          String?
  socialHandle           String?
  supportRequests        Json?
  verificationPreference Json?
  officeImageUrl         String?
  knownCraft             String?
  hcrfSupport            Boolean              @default(false)
  lcadUpdatesConfig      Json?
  overviewConfig         Json?
  referralCode           String?              @unique
  cceApplications        CceApplication[]
  ccsiBatches            CcsiBatch[]
  ccsiProfiles           CcsiProfile[]
  user                   User?                @relation(fields: [userId], references: [id])
  posts                  OfficeBlogPost[]
  subscriptions          OfficeSubscription[]
}

model OfficeSubscription {
  id        String            @id @default(cuid())
  userId    String
  officeId  String
  createdAt DateTime          @default(now())
  office    LegislativeOffice @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, officeId])
}

model OfficeBlogPost {
  id          String            @id @default(cuid())
  officeId    String
  title       String
  content     String
  tags        Json
  documents   Json?
  isPinned    Boolean           @default(false)
  isPublished Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  isTakedown  Boolean           @default(false)
  reports     BlogPostReport[]
  office      LegislativeOffice @relation(fields: [officeId], references: [id])
}

model BlogPostReport {
  id        String         @id @default(cuid())
  postId    String
  userId    String?
  reason    String
  status    String         @default("PENDING")
  createdAt DateTime       @default(now())
  post      OfficeBlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id])
}

model Donation {
  id            String        @id @default(cuid())
  userId        String?
  amount        Float
  donationType  String?
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  country       String?
  paymentMethod PaymentMethod
  status        String        @default("pending")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  pool          String?
  user          User?         @relation(fields: [userId], references: [id])
}

model Certification {
  id                  String        @id @default(cuid())
  userId              String?
  type                String
  name                String
  amount              Float
  firstName           String
  lastName            String
  email               String
  phone               String
  razorpayOrderId     String
  razorpayPaymentId   String?
  paymentMethod       PaymentMethod
  status              String        @default("pending")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  adminCertificateUrl String?
  user                User?         @relation(fields: [userId], references: [id])
}

model CertificatePackage {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  features    Json?
  validity    String?
  annualFee   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Initiative {
  id          String         @id @default(cuid())
  type        InitiativeType
  title       String
  tagline     String
  description String
  hashtags    Json
  images      Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  link        String?
}

model PageVisit {
  id        String   @id @default(cuid())
  pagePath  String
  ipAddress String?
  userAgent String?
  visitedAt DateTime @default(now())
}

model EvaluationSubmission {
  id                             String                           @id @default(cuid())
  userId                         String?
  businessName                   String?
  yearsInOperation               Int?
  craftType                      String?
  annualRevenue                  String?
  website                        String?
  score                          Float?
  tier                           String?
  answers                        Json?
  status                         MemberStatus                     @default(PENDING)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  evaluationType                 String?                          @default("SELF_ASSESSMENT")
  adminCertificateUrl            String?
  trackingId                     String?                          @unique
  entityType                     RegisterType?
  origin                         VerificationOrigin               @default(KHCRF)
  caseStatus                     VerificationCaseStatus?          @default(DRAFT)
  currentRevision                Int                              @default(0)
  craftloreEntityId              String?
  snapshotId                     String?
  snapshotSha256                 String?
  methodologyVersion             String?
  selfReportedPts                Float?
  submittedAt                    DateTime?
  receivedAt                     DateTime?
  reviewStartedAt                DateTime?
  completedAt                    DateTime?
  evidence                       EvaluationEvidence[]
  user                           User?                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  VerificationEvidence           VerificationEvidence[]
  VerificationFinding            VerificationFinding[]
  VerificationSubmissionRevision VerificationSubmissionRevision[]

  @@index([caseStatus])
  @@index([craftloreEntityId])
  @@index([entityType])
  @@index([origin])
}

model GrantApplication {
  id                   String   @id @default(cuid())
  userId               String
  applicantName        String
  organizationName     String?
  applicantType        String
  otherApplicantType   String?
  contactNumber        String
  email                String
  village              String
  district             String
  state                String
  country              String
  postalCode           String
  primaryCraft         String
  experienceYears      String
  artisansInvolved     String
  businessStage        String
  certificationStatus  String
  grantTypes           Json
  grantAmount          String
  grantPurpose         Json
  briefDescription     String
  projectDescription   String
  livelihoodImpact     String
  heritageContribution String
  budgetTools          String?
  budgetMaterials      String?
  budgetLabor          String?
  budgetMarketing      String?
  budgetOther          String?
  timeline             String
  previousGrants       String
  previousGrantDetails String?
  progressUpdates      String
  identityDoc          String?
  businessDoc          String?
  craftPhotosDoc       String?
  supportingDoc        String?
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])
}

model AccreditationApplication {
  id                  String   @id @default(cuid())
  userId              String?
  businessName        String
  contactPerson       String
  emailAddress        String
  phoneNumber         String
  businessAddress     String
  badges              Json
  businessDescription String
  productionMethods   String
  documentation       Json
  otherDocumentation  String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  adminCertificateUrl String?
  user                User?    @relation(fields: [userId], references: [id])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String?
  amount     Float
  currency   String   @default("INR")
  status     String
  orderId    String   @unique
  paymentId  String?
  signature  String?
  entityId   String?
  entityType String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PartnerApplication {
  id                  String   @id @default(cuid())
  orgName             String
  website             String?
  contactName         String
  email               String
  phone               String?
  country             String
  collaborationAreas  Json
  otherArea           String?
  projectTitle        String?
  projectDescription  String?
  expectedOutcomes    String?
  collaborationType   Json
  otherCollaboration  String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  supportingDoc       String?
  userId              String?
  logoUrl             String?
  collection          String?
  ecosystem_id        String?  @db.VarChar(255)
  is_parent_ecosystem Boolean? @default(false)
  parent_entity_id    String?  @db.VarChar(255)
  user                User?    @relation(fields: [userId], references: [id])
}

model Publication {
  id                     String                       @id @default(cuid())
  title                  String
  subtitle               String?
  author                 String
  published              String
  category               String
  price                  Float
  pages                  Int
  description            String
  imagePath              String
  slug                   String                       @unique
  features               Json?
  tableOfContents        Json?
  language               String?
  formats                Json?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  categoryId             String?
  pdfPath                String?
  type                   PublicationType              @default(PDF)
  accessType             String                       @default("PUBLIC")
  citationEnabled        Boolean                      @default(false)
  downloadUrl            String?
  fullContent            String?
  isMemberOnly           Boolean                      @default(false)
  isPublic               Boolean                      @default(true)
  memberDownloadUrl      String?
  previewContent         String?
  publicationType        String                       @default("EBOOK")
  publishedStatus        String                       @default("DRAFT")
  seoDescription         String?
  seoTitle               String?
  structuredDataType     String?                      @default("Book")
  contributorId          String?
  metadata               Json?
  submittedByContributor Boolean                      @default(false)
  revision               Int                          @default(1)
  chapters               Chapter[]
  citations              Citation[]
  auditLogs              EditorialAuditLog[]
  publicationCategory    PublicationCategory?         @relation(fields: [categoryId], references: [id])
  contributor            User?                        @relation("contributorPublications", fields: [contributorId], references: [id])
  assets                 PublicationAsset[]
  contributors           PublicationContributor[]
  seo                    PublicationDiscoverability?
  editions               PublicationEdition[]
  editorial              PublicationEditorial?
  entities               PublicationEntityRelation[]
  publicationMetadata    PublicationMetadata?
  readerExp              PublicationReaderExperience?
  relationsOut           PublicationRelation[]        @relation("PublicationSource")
  relationsIn            PublicationRelation[]        @relation("PublicationTarget")
  research               PublicationResearch?
  workflowHistory        PublicationWorkflowHistory[]
  purchases              UserPurchase[]
  reviews                PublicationReview[]

  @@index([revision])
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  updatedAt DateTime @updatedAt
}

model Chapter {
  id            String              @id @default(cuid())
  title         String
  order         Int
  publicationId String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sectionType   String?             @default("chapter")
  status        String?             @default("DRAFT")
  summary       String?
  pages         BookPage[]
  publication   Publication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  reviews       ChapterReview[]
  citations     Citation[]
  auditLogs     EditorialAuditLog[]
  sections      Section[]

  @@unique([publicationId, order])
}

model BookPage {
  id         String   @id @default(cuid())
  content    String
  pageNumber Int
  chapterId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}


model KHCRFVerifiedResult {
  id                  String   @id @default(uuid())
  evaluationId        String
  trackingId          String
  entityId            String?
  entityType          String
  craftType           String?
  verificationVersion Int
  verifiedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  factors       KHCRFVerifiedFactorResult[]
  transmissions VerificationTransmission[]
}

model KHCRFVerifiedFactorResult {
  id                     String   @id @default(uuid())
  verifiedResultId       String
  factorCode             String
  findingStatus          String
  evidenceReferenceCount Int
  findingId              String?

  verifiedResult KHCRFVerifiedResult @relation(fields: [verifiedResultId], references: [id])
}

model VerificationTransmission {
  id                String   @id @default(uuid())
  verifiedResultId  String
  destination       String
  status            String
  attemptCount      Int      @default(0)
  lastAttemptAt     DateTime?
  transmittedAt     DateTime?
  externalReference String?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  verifiedResult KHCRFVerifiedResult @relation(fields: [verifiedResultId], references: [id])
}

model UserPurchase {
  id            String      @id @default(cuid())
  userId        String
  publicationId String
  purchaseDate  DateTime    @default(now())
  amount        Float
  transactionId String?
  publication   Publication @relation(fields: [publicationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, publicationId])
}

model PublicationCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publications Publication[]
}

model JobPosting {
  id               String           @id @default(cuid())
  slug             String           @unique
  jobCode          String           @unique
  title            String
  department       String
  location         String
  type             String
  salaryRange      String?
  description      String
  responsibilities Json
  requirements     Json
  status           JobStatus        @default(OPEN)
  postedAt         DateTime         @default(now())
  expiresAt        DateTime?
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]
}

model JobApplication {
  id              String            @id @default(cuid())
  jobId           String?
  fullName        String
  email           String
  phone           String
  resumeUrl       String
  coverLetter     String?
  linkedinProfile String?
  portfolioUrl    String?
  status          ApplicationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  job             JobPosting?       @relation(fields: [jobId], references: [id])
}

model CcsiProfile {
  id                      String             @id @default(cuid())
  legislativeOfficeId     String?
  batchId                 String?
  userId                  String?
  applicationCode         String?            @unique
  jurisdictionExpiresAt   DateTime?
  auditLog                Json?
  applicantCategory       String
  fullName                String
  businessName            String?
  fatherName              String?
  gender                  String?
  primaryContact          String
  alternateContact        String?
  email                   String?
  village                 String
  district                String
  clusterName             String?
  primaryCraft            String
  secondaryCraft          String?
  yearsExperience         Int?
  familyLineage           Boolean?
  giAssociation           String?
  monthlyCapacity         String?
  capacityUnit            String?
  numberOfWorkers         Int?
  workshopAddress         String?
  workshopSeparate        Boolean?
  rawMaterials            String?
  toolsUsed               String?
  geoCaptured             Boolean?           @default(false)
  latitude                Float?
  longitude               Float?
  docGovId                String?
  docArtisanCard          String?
  docGiCertificate        String?
  docGst                  String?
  docUdyam                String?
  docInstitution          String?
  completenessScore       Int?
  salesChannels           Json?
  consentDeclared         Boolean            @default(false)
  digitalSignature        String?
  signature               String?
  signatureTimestamp      String?
  status                  String             @default("SUBMITTED")
  isCommerceInterested    Boolean            @default(false)
  isProfileCompleted      Boolean            @default(false)
  sellingOutsideDistrict  Boolean?
  bankAccountAvailable    Boolean?
  gstAvailable            String?
  maintainsPricingRecords Boolean?
  productionType          String?
  productionLeadTime      String?
  standardPackaging       Boolean?
  courierCapability       Boolean?
  digitalTools            Json?
  digitalPaymentsReady    Boolean?
  productSamples          Json?
  commerceConsent         Boolean?
  commerceStatus          String?            @default("INTEREST_SUBMITTED")
  referralId              String?            @unique
  referralCode            String?
  referralStatus          String?
  riskScore               String?
  auditAssigned           Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  batch                   CcsiBatch?         @relation(fields: [batchId], references: [id])
  legislativeOffice       LegislativeOffice? @relation(fields: [legislativeOfficeId], references: [id])
  user                    User?              @relation(fields: [userId], references: [id])

  @@index([legislativeOfficeId])
  @@index([primaryContact])
}

model CcsiBatch {
  id                  String            @id @default(cuid())
  legislativeOfficeId String
  status              String            @default("PENDING_VERIFICATION")
  totalProfiles       Int               @default(0)
  validProfiles       Int               @default(0)
  errorProfiles       Int               @default(0)
  riskLevel           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  legislativeOffice   LegislativeOffice @relation(fields: [legislativeOfficeId], references: [id])
  profiles            CcsiProfile[]
}

model CceApplication {
  id                       String             @id @default(cuid())
  userId                   String
  legislativeOfficeId      String?
  referenceNumber          String             @unique
  status                   String             @default("PENDING")
  stakeholderCategory      String
  entityName               String
