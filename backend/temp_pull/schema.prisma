generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccreditationApplication {
  id                  String   @id
  userId              String?
  businessName        String
  contactPerson       String
  emailAddress        String
  phoneNumber         String
  businessAddress     String
  badges              Json
  businessDescription String
  productionMethods   String
  documentation       Json
  otherDocumentation  String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  adminCertificateUrl String?
  User                User?    @relation(fields: [userId], references: [id])
}

model AdvisoryApplication {
  id                     String    @id
  referenceNumber        String    @unique
  fullName               String
  advisoryScope          String
  category               String
  organization           String?
  email                  String
  phone                  String?
  district               String?
  statement              String
  cvFileUrl              String?
  cvOriginalFilename     String?
  cvMimeType             String?
  cvSizeBytes            Int?
  consentAccepted        Boolean   @default(false)
  consentAcceptedAt      DateTime?
  status                 String    @default("SUBMITTED")
  assignedReviewerId     String?
  internalNotes          String?
  submittedAt            DateTime  @default(now())
  reviewedAt             DateTime?
  decisionAt             DateTime?
  appointmentScope       String?
  publicProfilePublished Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
}

model ApprenticeshipApplication {
  id                 String   @id
  userId             String?
  fullName           String
  dob                String
  gender             String
  contactNumber      String
  email              String
  city               String
  state              String
  country            String
  postalCode         String
  qualification      String
  otherQualification String?
  fieldOfStudy       String
  institution        String
  completionYear     String
  apprenticeTrack    Json
  preferredLocation  Json
  availability       Json
  skills             Json
  otherSkill         String?
  experience         String?
  motivation         String
  heritageMeaning    String?
  contribution       String
  cvUrl              String?
  portfolioLink      String?
  portfolioFileUrl   String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  User               User?    @relation(fields: [userId], references: [id])
}

model ApprenticeshipOpening {
  id           String   @id
  title        String
  description  String
  location     String
  type         String   @default("FULL_TIME")
  duration     String
  stipend      String?
  requirements Json
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Artisan {
  id                   String                 @id
  canonicalEntityId    String                 @unique
  birthYear            Int?
  deathYear            Int?
  activeRegion         String?
  biography            String?
  CanonicalEntity      CanonicalEntity        @relation(fields: [canonicalEntityId], references: [id])
  MasterArtisanFeature MasterArtisanFeature[]
}

model ArtisanAssertion {
  id                      String        @id
  artisan_id              String
  field_name              String
  raw_value               String?
  normalized_value        String?
  source_id               String
  source_page             String?
  source_row              String?
  source_record_reference String?
  confidence              Float?
  match_method            String?
  is_canonical            Boolean       @default(false)
  valid_from              DateTime?
  valid_to                DateTime?
  created_at              DateTime      @default(now())
  reconciliation_reason   String?
  MasterArtisan           MasterArtisan @relation(fields: [artisan_id], references: [id], onDelete: Cascade)
  Source                  Source        @relation(fields: [source_id], references: [id], onDelete: Cascade)
}

model ArtisanAward {
  id                      String                  @id
  award_name              String
  award_year              Int?
  award_year_text         String?
  award_level             String?
  awarding_authority      String?
  award_craft_original    String?
  normalized_craft_id     String?
  source_id               String?
  source_page             String?
  source_row              String?
  source_record_reference String?
  verification_status     String?
  associated_work         String?
  joint_awardee           String?
  normalized_award_type   String?
  award_search_status     String?                 @default("NOT_SEARCHED")
  recognition_exact_title String?
  recognition_level       String?
  GiCraft                 GiCraft?                @relation(fields: [normalized_craft_id], references: [id])
  Source                  Source?                 @relation(fields: [source_id], references: [id])
  ArtisanAwardRecipient   ArtisanAwardRecipient[]
}

model ArtisanAwardRecipient {
  id                   String        @id
  award_id             String
  artisan_id           String
  recipient_role       String?
  source_name_spelling String?
  MasterArtisan        MasterArtisan @relation(fields: [artisan_id], references: [id], onDelete: Cascade)
  ArtisanAward         ArtisanAward  @relation(fields: [award_id], references: [id], onDelete: Cascade)

  @@index([artisan_id])
  @@index([award_id])
}

model ArtisanCraftAffiliation {
  id                  String        @id
  artisan_id          String
  craft_id            String
  relationship_type   String
  verification_status String?
  source_id           String?
  source_page         String?
  notes               String?
  created_at          DateTime      @default(now())
  MasterArtisan       MasterArtisan @relation(fields: [artisan_id], references: [id], onDelete: Cascade)
  GiCraft             GiCraft       @relation(fields: [craft_id], references: [id])
  Source              Source?       @relation(fields: [source_id], references: [id])

  @@unique([artisan_id, craft_id, relationship_type])
  @@index([artisan_id])
  @@index([craft_id])
}

model ArtisanGiAuthorization {
  id                      String        @id
  artisan_id              String
  craft_id                String
  gi_authorized_user_id   String?
  gi_application_number   String?
  gi_registration_number  String?
  authorization_status    String?
  authorization_date      DateTime?
  source_id               String?
  source_page             String?
  source_row              String?
  source_record_reference String?
  MasterArtisan           MasterArtisan @relation(fields: [artisan_id], references: [id], onDelete: Cascade)
  GiCraft                 GiCraft       @relation(fields: [craft_id], references: [id])
  Source                  Source?       @relation(fields: [source_id], references: [id])
}

model ArtisanIdentifier {
  id                      String        @id
  artisan_id              String
  identifier_type         String
  identifier_value        String
  issuer                  String?
  status                  String?
  issued_date             DateTime?
  source_id               String?
  source_page             String?
  source_row              String?
  source_record_reference String?
  MasterArtisan           MasterArtisan @relation(fields: [artisan_id], references: [id], onDelete: Cascade)
  Source                  Source?       @relation(fields: [source_id], references: [id])

  @@index([identifier_type, identifier_value])
}

model ArtisanLineage {
  id                   String                 @id
  lineage_id           String?                @unique
  lineage_name         String
  primary_craft_id     String?
  district             String?
  risk_level           String?
  notes                String?
  ArtisanLineageMember ArtisanLineageMember[]
}

model ArtisanLineageMember {
  id                                                                   String         @id
  lineage_id                                                           String
  artisan_id                                                           String
  related_artisan_id                                                   String?
  relationship_type                                                    String
  verified                                                             Boolean        @default(false)
  source_id                                                            String?
  source_page                                                          String?
  source_row                                                           String?
  source_record_reference                                              String?
  MasterArtisan_ArtisanLineageMember_artisan_idToMasterArtisan         MasterArtisan  @relation("ArtisanLineageMember_artisan_idToMasterArtisan", fields: [artisan_id], references: [id], onDelete: Cascade)
  ArtisanLineage                                                       ArtisanLineage @relation(fields: [lineage_id], references: [id], onDelete: Cascade)
  MasterArtisan_ArtisanLineageMember_related_artisan_idToMasterArtisan MasterArtisan? @relation("ArtisanLineageMember_related_artisan_idToMasterArtisan", fields: [related_artisan_id], references: [id])
  Source                                                               Source?        @relation(fields: [source_id], references: [id])
}

model ArtisanNomination {
  id                         String              @id
  submissionNumber           String              @unique
  status                     ParticipationStatus @default(SUBMITTED)
  nomineeName                String
  localName                  String?
  craft                      String?
  primaryCraft               String?
  secondaryCrafts            String?
  unionTerritory             String?
  district                   String?
  tehsil                     String?
  village                    String?
  pinCode                    String?
  fullAddress                String?
  landmark                   String?
  workshop                   String?
  biography                  String?
  yearsOfPractice            Int?
  skills                     String?
  awards                     String?
  familyLineage              String?
  contactInfo                String?
  nominatorInfo              String?
  relationship               String?
  references                 String?
  consentGiven               Boolean             @default(false)
  hasGovtArtisanId           String?
  govtArtisanId              String?
  artisanRegistrationType    String?
  artisanIssuingAuthority    String?
  artisanYearOfRegistration  String?
  existingHcrfArtisanId      String?
  hasWorkshop                String?
  workshopName               String?
  workshopType               String?
  isWorkshopRegistered       String?
  workshopId                 String?
  workshopRegistrationType   String?
  workshopIssuingAuthority   String?
  workshopYearOfRegistration String?
  workshopAddress            String?
  workshopPinCode            String?
  existingHcrfWorkshopId     String?
  notes                      String?
  reviewerId                 String?
  isDeleted                  Boolean             @default(false)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime
  MediaAsset                 MediaAsset[]        @relation("NominationMedia")
}

model ArtisanProfile {
  id              String  @id
  listingId       String  @unique
  specialty       String?
  skillLevel      String?
  experienceYears Int?
  awards          String?
  catalogUrl      String?
  Listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model AssessmentCycle {
  id                      String                    @id
  name                    String
  year                    Int
  slug                    String                    @unique
  status                  String                    @default("DRAFT")
  timezone                String                    @default("IST")
  consultationStartAt     DateTime?
  consultationEndAt       DateTime?
  validationStartAt       DateTime?
  validationEndAt         DateTime?
  reportReleaseAt         DateTime?
  isActive                Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  DraftFinding            DraftFinding[]
  SkcHearing              SkcHearing[]
  skc_consultation_themes skc_consultation_themes[]
}

model BlogPostReport {
  id             String         @id
  postId         String
  userId         String?
  reason         String
  status         String         @default("PENDING")
  createdAt      DateTime       @default(now())
  OfficeBlogPost OfficeBlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User           User?          @relation(fields: [userId], references: [id])
}

model BookPage {
  id         String   @id
  content    String
  pageNumber Int
  chapterId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id            String  @id
  listingId     String  @unique
  name          String?
  email         String?
  address       String?
  foundedYear   Int?
  type          String?
  websiteUrl    String?
  productsSold  String?
  employeeCount Int?
  licenseNumber String?
  Listing       Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model CanonicalEntity {
  id                                                                    String                    @id
  slug                                                                  String                    @unique
  title                                                                 String
  summary                                                               String?
  aliases                                                               Json?
  transliterations                                                      Json?
  entityType                                                            CanonicalEntityType
  lifecycle                                                             LifecycleStatus           @default(DRAFT)
  visibility                                                            VisibilityStatus          @default(INTERNAL)
  verificationStatus                                                    VerificationStatus        @default(UNVERIFIED)
  sensitivity                                                           SensitivityClassification @default(NONE)
  metadata                                                              Json?
  aiEmbeddings                                                          Json?
  seoMetadata                                                           Json?
  version                                                               Int                       @default(1)
  createdById                                                           String?
  publishedAt                                                           DateTime?
  coverStoryTitle                                                       String?
  issueOverview                                                         String?
  featuredCraftName                                                     String?
  featuredCraftLabel                                                    String?
  coverImageAlt                                                         String?
  readerAssetKey                                                        String?
  downloadable                                                          Boolean                   @default(false)
  archivedAt                                                            DateTime?
  createdAt                                                             DateTime                  @default(now())
  updatedAt                                                             DateTime
  deletedAt                                                             DateTime?
  isDemo                                                                Boolean                   @default(false)
  isFeatured                                                            Boolean                   @default(false)
  isSeedData                                                            Boolean                   @default(false)
  displayPriority                                                       Int                       @default(0)
  Artisan                                                               Artisan?
  User                                                                  User?                     @relation(fields: [createdById], references: [id])
  Collection                                                            Collection?
  Craft                                                                 Craft?
  EntityRelationship_EntityRelationship_sourceEntityIdToCanonicalEntity EntityRelationship[]      @relation("EntityRelationship_sourceEntityIdToCanonicalEntity")
  EntityRelationship_EntityRelationship_targetEntityIdToCanonicalEntity EntityRelationship[]      @relation("EntityRelationship_targetEntityIdToCanonicalEntity")
  GlossaryTerm                                                          GlossaryTerm?
  Material                                                              Material?
  Motif                                                                 Motif?
  Product                                                               Product?
  ResearchPublication                                                   ResearchPublication?
  SourceReference                                                       SourceReference[]
  Studio                                                                Studio?
  Technique                                                             Technique?
  Tool                                                                  Tool?
  VerificationRecord                                                    VerificationRecord[]
  WorkflowRecord                                                        WorkflowRecord[]
  MediaAsset                                                            MediaAsset[]              @relation("EntityMedia")
  TaxonomyCategory                                                      TaxonomyCategory[]        @relation("EntityTaxonomy")

  @@index([createdById])
  @@index([deletedAt])
  @@index([entityType, lifecycle])
  @@index([slug])
  @@index([title])
  @@index([verificationStatus])
  @@index([visibility])
}

model CceApplication {
  id                       String             @id
  userId                   String
  legislativeOfficeId      String?
  referenceNumber          String             @unique
  status                   String             @default("PENDING")
  stakeholderCategory      String
  entityName               String
  ccsiRegistrationId       String
  referralCode             String?
  craftCategory            String
  clusterName              String?
  phone                    String
  email                    String
  address                  String
  awardCategory            String
  yearsExperience          Int
  productionScale          String
  teamSize                 Int?
  marketsServed            Json
  giStatus                 Boolean            @default(false)
  giAuthorizedNumber       String?
  giSupportingDoc          String?
  meritStatement           String
  productImages            Json?
  certifications           Json?
  giDocumentation          Json?
  exportRecords            Json?
  mediaCoverage            Json?
  testimonials             Json?
  complianceDocs           Json?
  complianceAccurate       Boolean            @default(false)
  meritBasedAck            Boolean            @default(false)
  noSponsorshipImpact      Boolean            @default(false)
  publicDisplayConsent     Boolean            @default(false)
  signature                String
  signatureDate            DateTime           @default(now())
  communityImpact          Json?
  sustainability           Json?
  complianceScore          Float              @default(0)
  craftQualityScore        Float              @default(0)
  innovationScore          Float              @default(0)
  clusterContributionScore Float              @default(0)
  marketReadinessScore     Float              @default(0)
  documentationScore       Float              @default(0)
  totalScore               Float              @default(0)
  adminNotes               String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime
  LegislativeOffice        LegislativeOffice? @relation(fields: [legislativeOfficeId], references: [id])
  User                     User               @relation(fields: [userId], references: [id])

  @@index([ccsiRegistrationId])
  @@index([referenceNumber])
  @@index([userId])
}

model CcsiBatch {
  id                  String            @id
  legislativeOfficeId String
  status              String            @default("PENDING_VERIFICATION")
  totalProfiles       Int               @default(0)
  validProfiles       Int               @default(0)
  errorProfiles       Int               @default(0)
  riskLevel           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  LegislativeOffice   LegislativeOffice @relation(fields: [legislativeOfficeId], references: [id])
  CcsiProfile         CcsiProfile[]
}

model CcsiProfile {
  id                      String             @id
  legislativeOfficeId     String?
  batchId                 String?
  userId                  String?
  applicationCode         String?            @unique
  jurisdictionExpiresAt   DateTime?
  auditLog                Json?
  applicantCategory       String
  fullName                String
  businessName            String?
  fatherName              String?
  gender                  String?
  primaryContact          String
  alternateContact        String?
  email                   String?
  village                 String
  district                String
  clusterName             String?
  primaryCraft            String
  secondaryCraft          String?
  yearsExperience         Int?
  familyLineage           Boolean?
  giAssociation           String?
  monthlyCapacity         String?
  capacityUnit            String?
  numberOfWorkers         Int?
  workshopAddress         String?
  workshopSeparate        Boolean?
  rawMaterials            String?
  toolsUsed               String?
  geoCaptured             Boolean?           @default(false)
  latitude                Float?
  longitude               Float?
  docGovId                String?
  docArtisanCard          String?
  docGiCertificate        String?
  docGst                  String?
  docUdyam                String?
  docInstitution          String?
  completenessScore       Int?
  salesChannels           Json?
  consentDeclared         Boolean            @default(false)
  digitalSignature        String?
  signature               String?
  signatureTimestamp      String?
  status                  String             @default("SUBMITTED")
  isCommerceInterested    Boolean            @default(false)
  isProfileCompleted      Boolean            @default(false)
  sellingOutsideDistrict  Boolean?
  bankAccountAvailable    Boolean?
  gstAvailable            String?
  maintainsPricingRecords Boolean?
  productionType          String?
  productionLeadTime      String?
  standardPackaging       Boolean?
  courierCapability       Boolean?
  digitalTools            Json?
  digitalPaymentsReady    Boolean?
  productSamples          Json?
  commerceConsent         Boolean?
  commerceStatus          String?            @default("INTEREST_SUBMITTED")
  referralId              String?            @unique
  referralCode            String?
  referralStatus          String?
  riskScore               String?
  auditAssigned           Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime
  CcsiBatch               CcsiBatch?         @relation(fields: [batchId], references: [id])
  LegislativeOffice       LegislativeOffice? @relation(fields: [legislativeOfficeId], references: [id])
  User                    User?              @relation(fields: [userId], references: [id])

  @@index([legislativeOfficeId])
  @@index([primaryContact])
}

model CertificatePackage {
  id          String   @id
  name        String
  description String?
  price       Float
  features    Json?
  validity    String?
  annualFee   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Certification {
  id                  String        @id
  userId              String?
  type                String
  name                String
  amount              Float
  firstName           String
  lastName            String
  email               String
  phone               String
  razorpayOrderId     String
  razorpayPaymentId   String?
  paymentMethod       PaymentMethod
  status              String        @default("pending")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime
  adminCertificateUrl String?
  User                User?         @relation(fields: [userId], references: [id])
}

model Chapter {
  id                String              @id
  title             String
  order             Int
  publicationId     String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  sectionType       String?             @default("chapter")
  status            String?             @default("DRAFT")
  summary           String?
  BookPage          BookPage[]
  Publication       Publication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  ChapterReview     ChapterReview[]
  Citation          Citation[]
  EditorialAuditLog EditorialAuditLog[]
  Section           Section[]

  @@unique([publicationId, order])
}

model ChapterReview {
  id             String                @id
  chapterId      String
  reviewerId     String
  role           ReviewerRole          @default(PRIMARY_REVIEWER)
  blindType      BlindReviewType       @default(OPEN)
  recommendation ReviewRecommendation?
  scores         Json?
  status         ReviewStatus          @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime
  Chapter        Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  User           User                  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  ReviewComment  ReviewComment[]
}

model Citation {
  id             String         @id
  publicationId  String
  claim          String
  evidenceStatus EvidenceStatus @default(UNVERIFIED)
  sourceData     String?
  chapterId      String?
  sectionId      String?
  blockId        String?
  ContentBlock   ContentBlock?  @relation(fields: [blockId], references: [id])
  Chapter        Chapter?       @relation(fields: [chapterId], references: [id])
  Publication    Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  Section        Section?       @relation(fields: [sectionId], references: [id])
}

model Collection {
  id                String          @id
  canonicalEntityId String          @unique
  institutionName   String?
  curationFocus     String?
  CanonicalEntity   CanonicalEntity @relation(fields: [canonicalEntityId], references: [id])
}

model CommunityOrganization {
  id                String            @id
  org_type          String
  org_name          String
  description       String?
  community_id      String
  created_at        DateTime          @default(now())
  updated_at        DateTime
  WorkshopCommunity WorkshopCommunity @relation(fields: [community_id], references: [id], onDelete: Cascade)
}

model ConsultationSubmission {
  id                       String    @id
  consultationId           String    @unique
  participantType          String?
  district                 String?
  craft                    String?
  stakeholderType          String?
  aiNarrative              String?
  inferredTags             String[]
  inferredThemes           String[]
  challenges               Json?
  opportunityRanking       Json?
  governmentRecommendation String?
  industryRecommendation   String?
  immediateAction          String?
  intelligenceScore        Int?
  confidenceLevel          String?
  qualityIndicators        Json?
  evidenceCount            Int       @default(0)
  graphNodes               Json?
  graphEdges               Json?
  rawConsultationData      Json?
  evidenceMetadata         Json?
  submissionStatus         String    @default("SUBMITTED")
  status                   String    @default("RECEIVED")
  internalNotes            String?
  version                  String    @default("1.0")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  submittedAt              DateTime? @default(now())
}

model ContactSubmission {
  id        String   @id
  firstName String
  lastName  String
  email     String
  subject   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime
  artisanId String?
}

model ContentBlock {
  id             String           @id
  sectionId      String
  order          Int
  blockType      ContentBlockType
  content        String
  evidenceStatus EvidenceStatus?
  Citation       Citation[]
  Section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, order])
}

model ContributorApplication {
  id                             String              @id
  submissionNumber               String              @unique
  status                         ParticipationStatus @default(SUBMITTED)
  fullName                       String
  email                          String
  phone                          String
  country                        String
  stateRegion                    String
  districtCity                   String
  pinCode                        String?
  currentAddress                 String?
  preferredContactMethod         String?
  contributorCategory            String
  currentProfession              String
  organization                   String?
  highestQualification           String?
  shortBio                       String
  linkedinProfile                String?
  personalWebsite                String?
  portfolioUrl                   String?
  orcidProfile                   String?
  existingHcrfMemberId           String?
  areasOfContribution            String
  primaryCraftSpecialisation     String?
  additionalCraftSpecialisations String?
  natureOfKnowledge              String?
  yearsOfExperience              String
  geographicAvailability         String
  accessibleDistricts            String?
  preferredEngagementType        String
  availability                   String
  timeCommitment                 String
  equipmentAndSoftware           String?
  relevantCertifications         String?
  relevantTraining               String?
  referenceName                  String?
  referenceOrganization          String?
  referenceRelationship          String?
  referenceEmail                 String?
  referencePhone                 String?
  motivation                     String
  proposedContribution           String?
  relevantCommunityAccess        String?
  conflictOfInterest             String?
  declarationAccuracy            Boolean             @default(false)
  declarationRights              Boolean             @default(false)
  declarationEthical             Boolean             @default(false)
  declarationConfidentiality     Boolean             @default(false)
  declarationRepresentation      Boolean             @default(false)
  declarationSelection           Boolean             @default(false)
  declarationPrivacy             Boolean             @default(false)
  notes                          String?
  reviewerId                     String?
  isDeleted                      Boolean             @default(false)
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime
  MediaAsset                     MediaAsset[]        @relation("ContributorMedia")
}

model Craft {
  id                   String             @id
  canonicalEntityId    String             @unique
  historicalOrigin     String?
  culturalSignificance String?
  endangermentStatus   EndangermentStatus @default(STABLE)
  CanonicalEntity      CanonicalEntity    @relation(fields: [canonicalEntityId], references: [id])
  HearingCraft         HearingCraft[]
  SubscriberCraft      SubscriberCraft[]
}

model DashboardAuditLog {
  id               String   @id
  module           String
  recordType       String
  recordId         String
